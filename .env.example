# NODE_ENV=development
# PORT=3000
# SHUTDOWN_TIMEOUT_MS=15000
# HTTP_REQUEST_TIMEOUT_MS=30000
# INSTANCE_ID=

REDIS_URL=
QUEUE_NAME=video-processing
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CONCURRENCY=2
TEMP_DIR=/tmp/transcoder

# Required. Clients must send `Authorization: Bearer <API_KEY>` on every request.
# Generate one with: openssl rand -hex 32
API_KEY=

# LOG_LEVEL=info

# NATS is optional -- cross-service job intake/events (see README's "Cross-service
# communication (NATS)" section). The service runs fine on Redis+REST alone if unreachable.
# NATS_URL=nats://127.0.0.1:4222
# NATS_USER=
# NATS_PASSWORD=
# NATS_TLS=false

# Comma-separated list of origins allowed to call the API from a browser.
# CORS_ALLOWED_ORIGINS=

# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional resource ceilings (defaults shown)
# MAX_REQUEST_BODY_BYTES=65536
# MAX_INPUT_BYTES=5368709120
# MAX_CUSTOM_VARIANTS=6
# MAX_VARIANT_DIMENSION=2160
# MAX_STORYBOARD_FRAMES=500
# FFPROBE_TIMEOUT_MS=30000
# FFMPEG_TIMEOUT_MS=1800000
